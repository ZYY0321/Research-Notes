{
  "protocol": "task-package-v4",
  "id": "find-alias",
  "category": "e31-nologin",
  "instruction": "访达会打开 ~/Desktop/e31-nologin/seed/find-alias。里面有 target.txt、note-a.txt、note-b.txt。请给 target.txt 做一个替身，存到 ~/Desktop/e31-nologin/out/find-alias。不要用符号链接代替替身。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Finder",
        "bundle_ids": [
          "com.apple.finder"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Finder",
    "feature": "给指定文件做替身",
    "gradeable": true,
    "needs_login": false,
    "bypass": "ln -s 符号链接得 0。用 AppleScript 让访达制作替身，会得到同样的书签文件。",
    "grade_note": "替身文件以书签头开始，并且指向 target.txt。符号链接得 0。"
  },
  "outputs": [
    {
      "name": "find-alias",
      "path": "~/Desktop/e31-nologin/out/find-alias",
      "capture": "best_effort"
    }
  ]
}
