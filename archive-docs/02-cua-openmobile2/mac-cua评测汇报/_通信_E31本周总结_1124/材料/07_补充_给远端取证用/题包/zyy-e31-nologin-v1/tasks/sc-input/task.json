{
  "protocol": "task-package-v4",
  "id": "sc-input",
  "category": "e31-nologin",
  "instruction": "快捷指令已经打开。请新建一个快捷指令，名字是 ~/Desktop/e31-nologin/state/sc-input-mark.txt 第一行的标记，至少 1 个动作，并在设置里打开「接收输入」。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。若出现 iCloud、登录或欢迎窗口，选择以后再说或只用这台 Mac 本机，不要登录。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 120,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Shortcuts",
        "bundle_ids": [
          "com.apple.shortcuts"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Shortcuts",
    "feature": "让快捷指令接收输入",
    "gradeable": true,
    "needs_login": false,
    "bypass": "桌面文件得 0。快捷指令的脚本字典不能新建快捷指令。若把记录直接写进它的数据库，仍可能绕过。",
    "grade_note": "名字等于标记，接收输入为真，动作数至少 1。"
  }
}
