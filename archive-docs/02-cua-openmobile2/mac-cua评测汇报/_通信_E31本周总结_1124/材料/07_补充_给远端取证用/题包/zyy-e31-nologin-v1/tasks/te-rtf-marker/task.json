{
  "protocol": "task-package-v4",
  "id": "te-rtf-marker",
  "category": "e31-nologin",
  "instruction": "文本编辑已经打开。请新建一份富文本，不要存成纯文本。要写的那一行在 ~/Desktop/e31-nologin/state/te-rtf-marker-mark.txt 的第一行（E31- 加 6 位字符，每次运行都会换）。正文只放这一行。存到 ~/Desktop/e31-nologin/out/te-rtf-marker.rtf。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "TextEdit",
        "bundle_ids": [
          "com.apple.TextEdit"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "TextEdit",
    "feature": "新建富文本",
    "gradeable": true,
    "needs_login": false,
    "bypass": "纯文本和 textutil 转出的 RTF 没有文本编辑的窗口署名，得 0。用 AppleScript 让文本编辑自己存储，会带上同样的署名，这是残留绕过。",
    "grade_note": "正文去掉空白后必须正好是标记，并且文件带文本编辑存储时写上的窗口字段。"
  },
  "outputs": [
    {
      "name": "te-rtf-marker",
      "path": "~/Desktop/e31-nologin/out/te-rtf-marker.rtf",
      "capture": "best_effort"
    }
  ]
}
