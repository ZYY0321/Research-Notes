{
  "protocol": "task-package-v4",
  "id": "pv-rotate-90",
  "category": "e31-nologin",
  "instruction": "预览会打开 ~/Desktop/e31-nologin/seed/pv-rotate-90.pdf。请把这一页顺时针旋转 90 度，另存到 ~/Desktop/e31-nologin/out/pv-rotate-90.pdf。不要删页面上的 SEED- 那行，也不要把页面导出成图片。不要改原稿。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Preview",
        "bundle_ids": [
          "com.apple.Preview"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Preview",
    "feature": "顺时针转 90 度",
    "gradeable": true,
    "needs_login": false,
    "bypass": "复制原 PDF、或用 sips 重渲染，得 0。手写一份带同样批注字典的 PDF 仍可能得分。",
    "grade_note": "把这一页按给定角度旋转后另存。页面上的 SEED- 那行要还在，不要把页面重画成一张图。"
  },
  "outputs": [
    {
      "name": "pv-rotate-90",
      "path": "~/Desktop/e31-nologin/out/pv-rotate-90.pdf",
      "capture": "best_effort"
    }
  ]
}
