{
  "protocol": "task-package-v4",
  "id": "te-rtf-two",
  "category": "e31-nologin",
  "instruction": "文本编辑已经打开。请新建富文本，第一行写 AGENDA，第二行写 ~/Desktop/e31-nologin/state/te-rtf-two-mark.txt 第一行的标记。不要写别的字。存到 ~/Desktop/e31-nologin/out/te-rtf-two.rtf。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "TextEdit",
        "bundle_ids": [
          "com.apple.TextEdit"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "TextEdit",
    "feature": "两行议程",
    "gradeable": true,
    "needs_login": false,
    "bypass": "纯文本和 textutil 转出的 RTF 没有文本编辑的窗口署名，得 0。用 AppleScript 让文本编辑自己存储，会带上同样的署名，这是残留绕过。",
    "grade_note": "AGENDA 在前，标记在后。"
  },
  "outputs": [
    {
      "name": "te-rtf-two",
      "path": "~/Desktop/e31-nologin/out/te-rtf-two.rtf",
      "capture": "best_effort"
    }
  ]
}
