{
  "protocol": "task-package-v4",
  "id": "cal-alarm",
  "category": "e31-nologin",
  "instruction": "日历已经打开。请新建日程，标题是 ~/Desktop/e31-nologin/state/cal-alarm-mark.txt 第一行的标记，并加一个提前 15 分钟的提醒。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。若出现 iCloud、登录或欢迎窗口，选择以后再说或只用这台 Mac 本机，不要登录。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 120,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Calendar",
        "bundle_ids": [
          "com.apple.iCal"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Calendar",
    "feature": "提前 15 分钟提醒",
    "gradeable": true,
    "needs_login": false,
    "bypass": "桌面上的文本或导出文件不参与评分，得 0。用 AppleScript 直接改这个应用，会得到同样的终态，这是残留绕过。",
    "grade_note": "标题等于标记，显示提醒的触发间隔是 -15 分钟。"
  }
}
