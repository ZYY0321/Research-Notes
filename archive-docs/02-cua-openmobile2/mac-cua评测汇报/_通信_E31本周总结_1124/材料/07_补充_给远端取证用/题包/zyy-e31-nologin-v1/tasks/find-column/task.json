{
  "protocol": "task-package-v4",
  "id": "find-column",
  "category": "e31-nologin",
  "instruction": "访达会打开 ~/Desktop/e31-nologin/seed/find-column。请把这个窗口的显示方式改成分栏，然后关掉窗口，让访达把视图写进该文件夹的 .DS_Store。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Finder",
        "bundle_ids": [
          "com.apple.finder"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Finder",
    "feature": "把文件夹改成分栏视图",
    "gradeable": true,
    "needs_login": false,
    "bypass": "只含视图单词的文本文件得 0。手写一份 Bud1 的 .DS_Store 仍可能得分。",
    "grade_note": " .DS_Store 是 Bud1，并且视图记录是 clmv。普通文本得 0。"
  },
  "outputs": [
    {
      "name": "find-column-dsstore",
      "path": "~/Desktop/e31-nologin/seed/find-column/.DS_Store",
      "capture": "best_effort"
    }
  ]
}
