{
  "protocol": "task-package-v4",
  "id": "pv-sticky",
  "category": "e31-nologin",
  "instruction": "预览会打开 ~/Desktop/e31-nologin/seed/pv-sticky.pdf。请加一张便签，里面只写 ~/Desktop/e31-nologin/state/pv-sticky-mark.txt 第一行的标记，另存到 ~/Desktop/e31-nologin/out/pv-sticky.pdf。不要删页面上的 SEED- 那行，也不要改原稿。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Preview",
        "bundle_ids": [
          "com.apple.Preview"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Preview",
    "feature": "便签批注",
    "gradeable": true,
    "needs_login": false,
    "bypass": "复制原 PDF、或用 sips 重渲染，得 0。手写一份带同样批注字典的 PDF 仍可能得分。",
    "grade_note": "在副本上加一张便签批注，文字是标记；原页上的 SEED- 那行还在。"
  },
  "outputs": [
    {
      "name": "pv-sticky",
      "path": "~/Desktop/e31-nologin/out/pv-sticky.pdf",
      "capture": "best_effort"
    }
  ]
}
