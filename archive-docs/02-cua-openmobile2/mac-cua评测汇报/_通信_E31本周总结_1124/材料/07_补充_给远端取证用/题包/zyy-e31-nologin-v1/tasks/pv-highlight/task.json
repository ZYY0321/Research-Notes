{
  "protocol": "task-package-v4",
  "id": "pv-highlight",
  "category": "e31-nologin",
  "instruction": "预览会打开 ~/Desktop/e31-nologin/seed/pv-highlight.pdf。请把页面上 SEED- 开头的那一行高亮，另存到 ~/Desktop/e31-nologin/out/pv-highlight.pdf。不要删那行，也不要改原稿。标记文件 ~/Desktop/e31-nologin/state/pv-highlight-mark.txt 这次不用写进批注。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Preview",
        "bundle_ids": [
          "com.apple.Preview"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Preview",
    "feature": "高亮一行",
    "gradeable": true,
    "needs_login": false,
    "bypass": "复制原 PDF、或用 sips 重渲染，得 0。手写一份带同样批注字典的 PDF 仍可能得分。",
    "grade_note": "把页面上 SEED- 开头的那行高亮，存成副本。不要删掉那行文字。"
  },
  "outputs": [
    {
      "name": "pv-highlight",
      "path": "~/Desktop/e31-nologin/out/pv-highlight.pdf",
      "capture": "best_effort"
    }
  ]
}
