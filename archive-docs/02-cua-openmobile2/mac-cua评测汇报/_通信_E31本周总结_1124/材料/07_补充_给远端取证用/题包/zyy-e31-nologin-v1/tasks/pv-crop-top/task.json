{
  "protocol": "task-package-v4",
  "id": "pv-crop-top",
  "category": "e31-nologin",
  "instruction": "预览会打开 ~/Desktop/e31-nologin/seed/pv-crop-top.pdf。请把页面裁成上半部分（大约从页面中线裁到顶边），另存到 ~/Desktop/e31-nologin/out/pv-crop-top.pdf。整页的媒体框保持原样。不要删 SEED- 那行，也不要改原稿。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Preview",
        "bundle_ids": [
          "com.apple.Preview"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Preview",
    "feature": "裁成上半页",
    "gradeable": true,
    "needs_login": false,
    "bypass": "复制原 PDF、或用 sips 重渲染，得 0。手写一份带同样批注字典的 PDF 仍可能得分。",
    "grade_note": "把页面裁成上半部分后另存。媒体框仍是原来的整页，裁剪框盖住上半页。SEED- 那行要还在。"
  },
  "outputs": [
    {
      "name": "pv-crop-top",
      "path": "~/Desktop/e31-nologin/out/pv-crop-top.pdf",
      "capture": "best_effort"
    }
  ]
