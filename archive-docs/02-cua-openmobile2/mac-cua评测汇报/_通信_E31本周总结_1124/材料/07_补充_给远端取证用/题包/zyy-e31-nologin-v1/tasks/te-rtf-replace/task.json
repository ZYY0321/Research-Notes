{
  "protocol": "task-package-v4",
  "id": "te-rtf-replace",
  "category": "e31-nologin",
  "instruction": "文本编辑会打开 ~/Desktop/e31-nologin/seed/te-rtf-replace.rtf。请把其中的 TOKEN 换成 ~/Desktop/e31-nologin/state/te-rtf-replace-mark.txt 第一行的标记，KEEP-THIS-SENTENCE 要留下。用文本编辑存回这个文件，格式仍是富文本。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "TextEdit",
        "bundle_ids": [
          "com.apple.TextEdit"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "TextEdit",
    "feature": "替换指定单词",
    "gradeable": true,
    "needs_login": false,
    "bypass": "纯文本和 textutil 转出的 RTF 没有文本编辑的窗口署名，得 0。用 AppleScript 让文本编辑自己存储，会带上同样的署名，这是残留绕过。",
    "grade_note": "标记替换 TOKEN，原句还在。文件里不能再出现 TOKEN。"
  },
  "outputs": [
    {
      "name": "te-rtf-replace",
      "path": "~/Desktop/e31-nologin/seed/te-rtf-replace.rtf",
      "capture": "best_effort"
    }
  ]
}
