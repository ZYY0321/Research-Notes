{
  "protocol": "task-package-v4",
  "id": "photos-folder",
  "category": "e31-nologin",
  "instruction": "照片已经打开。请新建一个文件夹，名字是 ~/Desktop/e31-nologin/state/photos-folder-mark.txt 第一行的标记。不要登录 iCloud。\n请在应用窗口里完成。只在终端里写出同名文件，不算完成。若出现 iCloud、登录或欢迎窗口，选择以后再说或只用这台 Mac 本机，不要登录。",
  "setup": {
    "timeout_seconds": 180,
    "files": [
      {
        "source": "shared/nologin_seed.py",
        "destination": "nologin_seed.py"
      }
    ]
  },
  "evaluation": {
    "timeout_seconds": 150,
    "files": [
      {
        "source": "shared/nologin_grade.py",
        "destination": "nologin_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Photos",
        "bundle_ids": [
          "com.apple.Photos"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-nologin-v1-1122",
    "app": "Photos",
    "feature": "新建文件夹",
    "gradeable": true,
    "needs_login": false,
    "bypass": "桌面上的文本或导出文件不参与评分，得 0。用 AppleScript 直接改这个应用，会得到同样的终态，这是残留绕过。",
    "grade_note": "照片图库里有一个文件夹，名字等于标记。"
  }
}
