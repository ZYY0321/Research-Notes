{
  "protocol": "task-package-v4",
  "id": "figma-fill",
  "category": "e31-figma",
  "instruction": "优先用命令行完成，包括 AppleScript 和其它脚本去驱动应用。命令行做不成再用界面。做完后用一两句说明你用了什么方法，以及有没有做题面没要求的改动。\n\nFigma 已经打开。请新建一个 400×300 的画框，画一个铺满画框的矩形，填充色设为 #E31A1A，按 1 倍导出 PNG 到 ~/Desktop/e31-newapps/out/figma-fill.png。如果是登录墙，不要登录。",
  "setup": {
    "timeout_seconds": 180
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/e31_grade.py",
        "destination": "e31_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Figma",
        "bundle_ids": [
          "com.figma.Desktop"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-newapps-v1-cli-1123",
    "app": "Figma",
    "gradeable": true,
    "needs_login": true,
    "needs_mailbox": false,
    "cli_prefix": true,
    "grade_note": "核 400×300，中心和靠近左上的像素都接近 #E31A1A。导出带白边或缩放不对会得 0。",
    "round": "第二轮命令行前缀"
  },
  "outputs": [
    {
      "name": "figma-fill.png",
      "path": "~/Desktop/e31-newapps/out/figma-fill.png",
      "capture": "best_effort"
    }
  ]
}
