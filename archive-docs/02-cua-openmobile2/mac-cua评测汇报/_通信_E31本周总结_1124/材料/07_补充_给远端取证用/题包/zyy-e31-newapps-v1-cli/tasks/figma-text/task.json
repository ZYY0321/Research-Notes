{
  "protocol": "task-package-v4",
  "id": "figma-text",
  "category": "e31-figma",
  "instruction": "优先用命令行完成，包括 AppleScript 和其它脚本去驱动应用。命令行做不成再用界面。做完后用一两句说明你用了什么方法，以及有没有做题面没要求的改动。\n\nFigma 已经打开。请在新建文件里加一个文字，内容是「E31-FIGMA」，然后把所在画框导出为 PNG，保存到 ~/Desktop/e31-newapps/out/figma-text.png。如果是登录墙，不要登录。",
  "setup": {
    "timeout_seconds": 180
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/e31_grade.py",
        "destination": "e31_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Figma",
        "bundle_ids": [
          "com.figma.Desktop"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-newapps-v1-cli-1123",
    "app": "Figma",
    "gradeable": true,
    "needs_login": true,
    "needs_mailbox": false,
    "cli_prefix": true,
    "grade_note": "只核 PNG 能解码且宽高不小于 32。不识别图里有没有 E31-FIGMA 这几个字。",
    "round": "第二轮命令行前缀"
  },
  "outputs": [
    {
      "name": "figma-text.png",
      "path": "~/Desktop/e31-newapps/out/figma-text.png",
      "capture": "best_effort"
    }
  ]
}
