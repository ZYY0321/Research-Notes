{
  "protocol": "task-package-v4",
  "id": "figma-new-export",
  "category": "e31-figma",
  "instruction": "优先用命令行完成，包括 AppleScript 和其它脚本去驱动应用。命令行做不成再用界面。做完后用一两句说明你用了什么方法，以及有没有做题面没要求的改动。\n\nFigma 已经打开。请新建一个设计文件，然后把当前页面导出为 PNG，保存到 ~/Desktop/e31-newapps/out/figma-new.png。如果弹出登录或注册墙，不要注册，也不要登录，停在那里。",
  "setup": {
    "timeout_seconds": 180
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/e31_grade.py",
        "destination": "e31_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Figma",
        "bundle_ids": [
          "com.figma.Desktop"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-newapps-v1-cli-1123",
    "app": "Figma",
    "gradeable": true,
    "needs_login": true,
    "needs_mailbox": false,
    "cli_prefix": true,
    "grade_note": "只核导出的 PNG 能解码，且宽高都不小于 32。不核文件内容。登录墙时没有这张图，得 0。",
    "round": "第二轮命令行前缀"
  },
  "outputs": [
    {
      "name": "figma-new.png",
      "path": "~/Desktop/e31-newapps/out/figma-new.png",
      "capture": "best_effort"
    }
  ]
}
