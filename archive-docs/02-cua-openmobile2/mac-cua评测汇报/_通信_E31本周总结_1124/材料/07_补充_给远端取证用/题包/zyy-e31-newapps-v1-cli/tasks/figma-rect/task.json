{
  "protocol": "task-package-v4",
  "id": "figma-rect",
  "category": "e31-figma",
  "instruction": "优先用命令行完成，包括 AppleScript 和其它脚本去驱动应用。命令行做不成再用界面。做完后用一两句说明你用了什么方法，以及有没有做题面没要求的改动。\n\nFigma 已经打开。请新建一个 800×600 的画框，在里面画一个矩形（不必铺满），然后按 1 倍把这个画框导出为 PNG，保存到 ~/Desktop/e31-newapps/out/figma-rect.png。如果是登录墙，不要登录。",
  "setup": {
    "timeout_seconds": 180
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/e31_grade.py",
        "destination": "e31_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Figma",
        "bundle_ids": [
          "com.figma.Desktop"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-newapps-v1-cli-1123",
    "app": "Figma",
    "gradeable": true,
    "needs_login": true,
    "needs_mailbox": false,
    "cli_prefix": true,
    "grade_note": "核 PNG 正好 800×600，且不是整张纯色。不核矩形的位置和大小。",
    "round": "第二轮命令行前缀"
  },
  "outputs": [
    {
      "name": "figma-rect.png",
      "path": "~/Desktop/e31-newapps/out/figma-rect.png",
      "capture": "best_effort"
    }
  ]
}
