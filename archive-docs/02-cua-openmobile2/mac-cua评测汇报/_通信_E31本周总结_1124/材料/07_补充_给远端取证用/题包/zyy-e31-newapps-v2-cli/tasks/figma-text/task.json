{
  "protocol": "task-package-v4",
  "id": "figma-text",
  "category": "e31-figma",
  "instruction": "能用终端就先用终端。请在题面里的那个应用里把事情做完，成品由这个应用自己交出来。不要用 AppleScript 去驱动应用，也不要结束、杀掉或重启它的进程，更不要用别的程序生成成品文件。终端做不成就改用界面。做完后用一两句说明用了什么方法，以及有没有做题面没要求的改动。\n\nFigma 已经打开。请在新建文件里加一个文字，内容是「E31-FIGMA」，然后把所在画框导出为 PNG，保存到 ~/Desktop/e31-newapps/out/figma-text.png。如果是登录墙，不要登录。",
  "setup": {
    "timeout_seconds": 180
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/e31_grade.py",
        "destination": "e31_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Figma",
        "bundle_ids": [
          "com.figma.Desktop"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-newapps-v2-cli-1123",
    "suite": "zyy-e31-newapps-v2-cli",
    "app": "Figma",
    "gradeable": true,
    "needs_login": true,
    "needs_mailbox": false,
    "cli_prefix": true,
    "grade_note": "只核 PNG 能解码且宽高不小于 32。不识别图里有没有 E31-FIGMA 这几个字。",
    "round": "v2 终端优先"
  },
  "outputs": [
    {
      "name": "figma-text.png",
      "path": "~/Desktop/e31-newapps/out/figma-text.png",
      "capture": "best_effort"
    }
  ]
}
