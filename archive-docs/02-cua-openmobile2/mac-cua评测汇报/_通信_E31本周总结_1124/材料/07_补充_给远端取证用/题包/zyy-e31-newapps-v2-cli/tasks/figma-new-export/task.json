{
  "protocol": "task-package-v4",
  "id": "figma-new-export",
  "category": "e31-figma",
  "instruction": "能用终端就先用终端。请在题面里的那个应用里把事情做完，成品由这个应用自己交出来。不要用 AppleScript 去驱动应用，也不要结束、杀掉或重启它的进程，更不要用别的程序生成成品文件。终端做不成就改用界面。做完后用一两句说明用了什么方法，以及有没有做题面没要求的改动。\n\nFigma 已经打开。请新建一个设计文件，然后把当前页面导出为 PNG，保存到 ~/Desktop/e31-newapps/out/figma-new.png。如果弹出登录或注册墙，不要注册，也不要登录，停在那里。",
  "setup": {
    "timeout_seconds": 180
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/e31_grade.py",
        "destination": "e31_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Figma",
        "bundle_ids": [
          "com.figma.Desktop"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-newapps-v2-cli-1123",
    "suite": "zyy-e31-newapps-v2-cli",
    "app": "Figma",
    "gradeable": true,
    "needs_login": true,
    "needs_mailbox": false,
    "cli_prefix": true,
    "grade_note": "只核导出的 PNG 能解码，且宽高都不小于 32。不核文件内容。登录墙时没有这张图，得 0。",
    "round": "v2 终端优先"
  },
  "outputs": [
    {
      "name": "figma-new.png",
      "path": "~/Desktop/e31-newapps/out/figma-new.png",
      "capture": "best_effort"
    }
  ]
}
