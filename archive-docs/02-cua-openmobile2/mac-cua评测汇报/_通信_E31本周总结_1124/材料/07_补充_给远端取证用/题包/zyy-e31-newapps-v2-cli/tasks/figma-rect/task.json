{
  "protocol": "task-package-v4",
  "id": "figma-rect",
  "category": "e31-figma",
  "instruction": "能用终端就先用终端。请在题面里的那个应用里把事情做完，成品由这个应用自己交出来。不要用 AppleScript 去驱动应用，也不要结束、杀掉或重启它的进程，更不要用别的程序生成成品文件。终端做不成就改用界面。做完后用一两句说明用了什么方法，以及有没有做题面没要求的改动。\n\nFigma 已经打开。请新建一个 800×600 的画框，在里面画一个矩形（不必铺满），然后按 1 倍把这个画框导出为 PNG，保存到 ~/Desktop/e31-newapps/out/figma-rect.png。如果是登录墙，不要登录。",
  "setup": {
    "timeout_seconds": 180
  },
  "evaluation": {
    "timeout_seconds": 90,
    "files": [
      {
        "source": "shared/e31_grade.py",
        "destination": "e31_grade.py"
      }
    ]
  },
  "requirements": {
    "apps": [
      {
        "name": "Figma",
        "bundle_ids": [
          "com.figma.Desktop"
        ]
      }
    ]
  },
  "metadata": {
    "batch": "zyy-e31-newapps-v2-cli-1123",
    "suite": "zyy-e31-newapps-v2-cli",
    "app": "Figma",
    "gradeable": true,
    "needs_login": true,
    "needs_mailbox": false,
    "cli_prefix": true,
    "grade_note": "核 PNG 正好 800×600，且不是整张纯色。不核矩形的位置和大小。",
    "round": "v2 终端优先"
  },
  "outputs": [
    {
      "name": "figma-rect.png",
      "path": "~/Desktop/e31-newapps/out/figma-rect.png",
      "capture": "best_effort"
    }
  ]
}
